{
  "name": "dsh-tts-chat-answer",
  "version": "0.1.0",
  "description": "Narrate completed assistant answers with Edge TTS, save audio locally, and play it in-page or in a native MPRIS player.",
  "author": "Vladimir Cores",
  "license": "MIT",
  "homepage": "https://github.com/VladimirCores/dsh-tts-chat-answer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirCores/dsh-tts-chat-answer.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "text-to-speech",
    "edge-tts",
    "narration",
    "accessibility"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-tts-chat-answer-setup": "./setup.mjs"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "test": "node test/plugin.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "setup.mjs",
    "icon.svg",
    "locale/en.json",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
